{
  "manifest_version": 2,
  "name": "Thunderbird AI Assistant",
  "version": "1.0",
  "description": "AI-powered email assistant using LangChain",
  "author": "OpenHands",
  "applications": {
    "gecko": {
      "id": "thunderbird-ai@openhands.example.com",
      "strict_min_version": "78.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesModify"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_popup": "popup.html",
    "default_title": "AI Assistant"
  }
}